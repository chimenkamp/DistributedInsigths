                </mxCell>
                <mxCell id="27" value="Fun With Alignments - (Centralized Calculations)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=20;" parent="1" vertex="1">
                    <mxGeometry x="80" y="20" width="280" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="28" value="Traces (\( \lambda_n \)): &#xa;\( \lambda_1 = (A, B,  D, E) \)&#xa;\( \lambda_2 = (A, C, D, E) \)&#xa;\( \lambda_3 = (A, B, E, D) \)" style="rounded=0;whiteSpace=wrap;align=left;fontStyle=0;fontSize=19;horizontal=1;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="80" y="240" width="680" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="29" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=none;opacity=50;" parent="1" vertex="1">
                    <mxGeometry x="80" y="271" width="180" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="30" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=none;opacity=50;" parent="1" vertex="1">
                    <mxGeometry x="80" y="313" width="180" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="31" value="Trace (\( \lambda_1 = (A, B,  D, E) \)): &#xa;&#xa;Step 1: State (\( 0, [p_0] \)) -&gt; trace expects A, model can fire A → synchronous move&#xa;&#xa;Step 2: State (\( 1, [p_1] \))&#xa;&#xa;&#xa;Step 3: State (\( 2, [p_2] \))&#xa;&#xa;&#xa;Step 4: State (\( 3, [p_3] \))&#xa;&#xa;&#xa;We reach \( (4, [p_f]) \)" style="rounded=0;whiteSpace=wrap;align=left;fontStyle=0;fontSize=19;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="80" y="400" width="680" height="340" as="geometry"/>
                </mxCell>
                <mxCell id="32" value="Trace \(\lambda_3 = \langle A, B, E, D \rangle\)&#xa;&#xa;...&#xa;  Option A - log move \((E, \gg)\): consume \(E\) from the trace, model stays at \([p_2]\). Cost: \(+1\).&#xa;  Option B - model move \((\gg, D)\): fire \(D\) in the model, trace index stays at 2. Cost: \(+1\).&#xa;&#xa;Branch A (log move on \(E\))&#xa;&#xa;Step 4a - State \((3, [p_2])\): trace has \(D\), model can fire \(D\) → synchronous move. Cost so far: 1.&#xa;&#xa;Step 5a - State \((4, [p_3])\): trace fully consumed, but marking is \([p_3] \neq [p_f]\). Must fire \(E\) as model move \((\gg, E)\). Cost: \(+1\).&#xa;&#xa;Total cost: 2.&#xa;&#xa;Branch B (model move on \(D\))&#xa;&#xa;Step 4b - State \((2, [p_3])\): trace has \(E\), model can fire \(E\) → synchronous move. Cost so far: 1.&#xa;&#xa;Step 5b - State \((3, [p_f])\): trace has \(D\) remaining, model is in final marking. Must take log move \((D, \gg)\). Cost: \(+1\).&#xa;&#xa;Total cost: 2.&#xa;&#xa;Both optimal alignments yield a cost of 2. The swap of \(D\) and \(E\) requires exactly one log move and one model move." style="rounded=0;whiteSpace=wrap;align=left;fontStyle=0;fontSize=19;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="80" y="760" width="680" height="700" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
