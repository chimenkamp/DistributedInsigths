                </mxCell>
                <mxCell id="hx_ss2NBBmB1ZysV6d2X-1" value="Fun With Alignments - (Questions)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=20;" parent="1" vertex="1">
