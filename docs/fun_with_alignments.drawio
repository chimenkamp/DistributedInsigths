                <mxCell id="ORASuy35DfLiRysUgv0I-4" value="The cascading is insane for long traces" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
