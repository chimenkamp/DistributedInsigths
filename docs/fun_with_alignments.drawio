                        <mxPoint x="1750" y="895" as="sourcePoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ORASuy35DfLiRysUgv0I-3" value="What if there exists an alternative decomposition with lower global const that dosnt route through C?&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;-&amp;gt; We pick the entry point based on the tree structure... So which entrypoint leads to the target activity? Isnt that locally greedy? What if there exists multiple entrypoints leading to the same target.&amp;nbsp;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="1720" y="860" width="230" height="150" as="geometry"/>
